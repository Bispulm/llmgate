      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(llmgate_attempts_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failures by kind",
