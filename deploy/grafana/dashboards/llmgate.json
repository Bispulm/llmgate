        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, model) (rate(llmgate_charged_micros_total[$__rate_interval])) * 3600 / 1e6",
          "legendFormat": "{{provider}}/{{model}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Charges by kind, USD per hour",
      "description": "Conservative charges are attempts whose cost was never reported.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
